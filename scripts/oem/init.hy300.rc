# Best-effort: this unit's vendor init does not import /oem.
# Service only sends HOME. Do not call SetSource / svpstop here (hangs AV-MIPS).
on property:sys.boot_completed=1
    start hy300local

service hy300local /system/bin/sh /oem/hy300-local.sh
    class late_start
    user shell
    group shell
    oneshot
    disabled
